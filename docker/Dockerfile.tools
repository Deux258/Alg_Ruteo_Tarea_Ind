FROM debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8
ARG SCAMPER_VERSION=20260902
ARG SCAMPER_SHA256=a2c5bc636d6351a395f57e121b4d813f46c001e7b831b538fd467b9cbc7625de
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends build-essential ca-certificates curl libpcap-dev libssl-dev tshark iproute2 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://www.caida.org/catalog/software/scamper/code/scamper-cvs-${SCAMPER_VERSION}.tar.gz -o /tmp/scamper.tar.gz \
 && echo "${SCAMPER_SHA256}  /tmp/scamper.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/scamper.tar.gz -C /tmp \
 && cd /tmp/scamper-cvs-${SCAMPER_VERSION} \
 && ./configure --prefix=/usr/local && make -j4 && make install && ldconfig \
 && rm -rf /tmp/scamper*
ENV TZ=UTC
WORKDIR /work
CMD ["scamper", "-v"]
